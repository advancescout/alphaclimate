{
  "redirects": [
    {
      "source": "/kbsmediavideomaker",
      "destination": "https://www.kbsmediavideomaker.com",
      "permanent": true
    },
    {
      "source": "/kbsmediavideomaker/",
      "destination": "https://www.kbsmediavideomaker.com",
      "permanent": true
    },
    {
      "source": "/kbsmediavideomaker/:path+",
      "destination": "https://www.kbsmediavideomaker.com/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.kgz",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}

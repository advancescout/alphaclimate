{
  "rewrites": [
    {
      "source": "/kbsmediavideomaker/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?kbsmediavideomaker\\.com" }],
      "destination": "/kbsmediavideomaker/:path*"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?kbsmediavideomaker\\.com" }],
      "destination": "/kbsmediavideomaker/index.html"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(www\\.)?kbsmediavideomaker\\.com" }],
      "destination": "/kbsmediavideomaker/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.kgz",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/kbsmediavideomaker/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
